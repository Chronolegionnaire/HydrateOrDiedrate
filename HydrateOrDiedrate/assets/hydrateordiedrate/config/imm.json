{
  "Dependencies": [
    {
      //Disable dana tweaks rain collection
      //TODO if/when alternative resolution options become a thing, add an option to use dana tweaks raincollection but with HoD rainwater
      "ModId": "danatweaks",
      "Label": "Incompatibility",
      "Description": "Overlapping rain collection system",
      "Severity": "Warning",
      "Criteria": [
        {
          "Type": "Setting",
          "Target": {
            "ModId": "danatweaks",
            "ConfigFile": "DanaTweaks-Server.json",
            "Map": "RainCollector.Enabled"
          },
          "Operator": "Equal",
          "Value": true
        },
        {
          "Type": "Setting",
          "Target": {
            "ConfigFile": "HydrateOrDiedrateConfig.json",
            "Map": "Rain.EnableRainGathering"
          },
          "Operator": "Equal",
          "Value": true
        }
      ],
      "Resolution": {
        "Type": "SetSetting",
        "Target": {
          "ModId": "danatweaks",
          "ConfigFile": "DanaTweaks-Server.json",
          "Map": "RainCollector.Enabled"
        },
        "Value": false
      }
    }
  ]
}